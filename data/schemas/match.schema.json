{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://premierleagueios.local/schemas/match.schema.json",
  "title": "Confronto",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_id", "competition_id", "edition_id", "season", "internal_round", "home_team_id", "away_team_id", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "match_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "competition_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "season": {"type": "integer", "minimum": 2023},
    "cartola_round": {"type": ["integer", "null"], "minimum": 1, "maximum": 38},
    "internal_round": {"type": ["integer", "null"], "minimum": 1},
    "phase": {"type": ["string", "null"]},
    "home_team_id": {"type": "integer", "minimum": 1},
    "away_team_id": {"type": ["integer", "null"], "minimum": 1},
    "home_score": {"type": ["number", "null"]},
    "away_score": {"type": ["number", "null"]},
    "winner_team_id": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["scheduled", "partial", "final", "cancelled", "unavailable"]},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
