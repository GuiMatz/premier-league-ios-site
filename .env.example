# Copie para .env.local e preencha apenas o que for usar. Nunca versione valores reais.

# --- Funções serverless do Cartola (api/cartola) ---
# Slug da liga clássica no Cartola FC. Sem valor, usa um slug fictício de exemplo.
CARTOLA_LEAGUE_SLUG=

# --- API de leitura da liga (api/league) ---
# Provider de leitura: "file" (padrão, lê data/league-next do próprio repositório) ou "github".
LEAGUE_READ_PROVIDER=
# Obrigatórias somente com LEAGUE_READ_PROVIDER=github (token com escopo mínimo, somente leitura).
LEAGUE_GITHUB_OWNER=
LEAGUE_GITHUB_REPO=
LEAGUE_GITHUB_BRANCH=
LEAGUE_GITHUB_TOKEN=
LEAGUE_GITHUB_ROOT=
# "true" libera leitura de artefatos de observação (shadow) apenas para depuração local.
LEAGUE_API_ENABLE_SHADOW_DEBUG=

# --- Laboratório de armazenamento (scripts/github-storage-lab.mjs, workflow manual) ---
GITHUB_TOKEN=
GITHUB_REPO=
LEAGUE_OFFICIAL_BRANCH=
LEAGUE_EXPECTED_MAIN_SHA=

# --- Smoke test contra um deploy de preview (scripts/phase-3k-smoke.mjs) ---
PREVIEW_URL=
